class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        vector<int>hash(256,-1);
        int max_len=0,idx=0;
        int l=0,r=s.size()-1;
        while(idx<=r){
            if(hash[s[idx]]!=-1){
                if(hash[s[idx]]>=l){
                    l=hash[s[idx]]+1;
                }
            }
            int len=idx-l+1;
            max_len=max(max_len,len);
            hash[s[idx]]=idx;
            idx++;
        }
        return  max_len;
    }
};
